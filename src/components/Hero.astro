---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/images/Profile Photo.webp';
const baseUrl = import.meta.env.BASE_URL;
const projectsUrl = `${baseUrl}/projects`;
const aboutUrl = `${baseUrl}/#about`;
---

<section class="min-h-[calc(100vh-4rem)] flex items-center">
  <div class="max-w-6xl mx-auto px-6 py-20 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-16 items-center">

      <!-- Text -->
      <div>
        <div class="flex items-center gap-3 mb-7 opacity-0 animate-fade-up" style="animation-delay: 0ms; animation-fill-mode: forwards;">
          <span class="block w-8 h-px bg-brass flex-shrink-0"></span>
          <span class="font-mono text-xs text-brass tracking-[0.2em] uppercase">Mechanical Engineer</span>
        </div>

        <h1 class="font-display font-light leading-[0.9] text-chalk mb-8 opacity-0 animate-fade-up" style="animation-delay: 80ms; animation-fill-mode: forwards;">
          <span class="block text-6xl md:text-7xl lg:text-8xl">Ryan</span>
          <span class="block text-6xl md:text-7xl lg:text-8xl italic text-brass">Hailey</span>
        </h1>

        <p class="text-chalk-secondary text-lg leading-relaxed max-w-lg mb-3 opacity-0 animate-fade-up" style="animation-delay: 180ms; animation-fill-mode: forwards;">
          Current interests include robotics, automation, lifting weights and longevity.
          I'm a little obsessed with learning how things work.
        </p>

        <p class="font-mono text-xs text-chalk-muted tracking-[0.15em] mb-10 opacity-0 animate-fade-up" style="animation-delay: 240ms; animation-fill-mode: forwards;">
          BS MECHANICAL ENGINEERING · UT ARLINGTON · CLASS OF 2026
        </p>

        <div class="flex flex-wrap gap-3 opacity-0 animate-fade-up" style="animation-delay: 320ms; animation-fill-mode: forwards;">
          <a href={projectsUrl}
             class="inline-flex items-center gap-2 px-6 py-3 bg-brass text-ink text-sm font-medium tracking-wide rounded hover:bg-brass-light transition-colors duration-200">
            View Projects
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a href={aboutUrl}
             class="inline-flex items-center gap-2 px-6 py-3 border border-ink-line text-sm font-medium text-chalk-secondary tracking-wide rounded hover:border-chalk-muted hover:text-chalk transition-colors duration-200">
            About Me
          </a>
        </div>
      </div>

      <!-- Photo -->
      <div class="hidden lg:flex justify-end opacity-0 animate-fade-up" style="animation-delay: 140ms; animation-fill-mode: forwards;">
        <div class="relative">
          <div class="absolute -inset-3 border border-ink-line rounded-sm pointer-events-none"></div>
          <div class="absolute -bottom-3 -right-3 w-full h-full border border-brass/25 rounded-sm pointer-events-none"></div>
          <div class="relative w-80 h-80 xl:w-96 xl:h-96 overflow-hidden rounded-xl">
            <Image
              src={profilePhoto}
              alt="Ryan Hailey"
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover scale-125 object-[center_60%]"
            />
          </div>
          <div class="absolute top-0 right-0 w-5 h-5 border-t-2 border-r-2 border-brass -translate-y-1 translate-x-1 pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-5 h-5 border-b-2 border-l-2 border-brass translate-y-1 -translate-x-1 pointer-events-none"></div>
        </div>
      </div>

    </div>

  </div>
</section>
