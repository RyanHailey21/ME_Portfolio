---
const baseUrl = import.meta.env.BASE_URL;

export interface Props {
  projects: {
    title: string;
    description: string;
    imageSrc: string;
    tags: string[];
    slug: string;
  }[];
}

const { projects } = Astro.props;
const total = projects.length;
---

<section class="py-20 border-b border-ink-line">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-10">
      <span class="block w-8 h-px bg-brass flex-shrink-0"></span>
      <span class="font-mono text-xs text-brass tracking-[0.2em] uppercase">Selected Work</span>
    </div>

    <!-- Slide stack — all items share the same grid cell -->
    <div class="grid" id="featuredCarousel">
      {projects.map((project, i) => (
        <div
          class="carousel-slide [grid-area:1/1] transition-opacity duration-700 border border-ink-line rounded overflow-hidden"
          style={i === 0 ? '' : 'opacity:0;pointer-events:none;'}
          data-index={i}
        >
          <div class="grid grid-cols-1 lg:grid-cols-2">

            <!-- Image -->
            <a href={`${baseUrl}/projects/${project.slug}`} class="block overflow-hidden bg-ink-card">
              <img
                src={project.imageSrc}
                alt={project.title}
                class="w-full h-full object-cover aspect-[4/3] lg:aspect-auto lg:h-full"
              />
            </a>

            <!-- Info panel -->
            <div class="bg-ink-card p-8 lg:p-10 flex flex-col justify-between min-h-[20rem]">
              <div>
                <span class="font-mono text-xs text-chalk-muted tracking-[0.2em]">
                  {String(i + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
                </span>
                <h2 class="font-display text-3xl lg:text-4xl font-light text-chalk mt-4 mb-3 leading-tight">
                  {project.title}
                </h2>
                <p class="text-chalk-secondary text-sm leading-relaxed mb-5 line-clamp-3">
                  {project.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag: string) => (
                    <span class="px-2.5 py-1 font-mono text-[11px] text-chalk-muted border border-ink-line rounded tracking-wide">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Footer: link + dots -->
              <div class="mt-8 flex items-center justify-between">
                <a
                  href={`${baseUrl}/projects/${project.slug}`}
                  class="inline-flex items-center gap-2 font-mono text-xs text-brass tracking-[0.15em] uppercase hover:gap-3 transition-all duration-200"
                >
                  View Project
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>

                <div class="flex items-center gap-2">
                  {projects.map((_: any, di: number) => (
                    <button
                      class={`carousel-dot rounded-full transition-all duration-300 ${
                        di === i
                          ? 'w-5 h-1.5 bg-brass'
                          : 'w-1.5 h-1.5 bg-ink-line hover:bg-chalk-muted'
                      }`}
                      data-dot={di}
                      aria-label={`Slide ${di + 1}`}
                    />
                  ))}
                </div>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.carousel-slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
  const total = slides.length;
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  // dots per slide: each slide has `total` dots; we need to address them grouped
  const dotsPerSlide = total;

  function goTo(index: number) {
    // hide current
    slides[current].style.opacity = '0';
    slides[current].style.pointerEvents = 'none';
    // deactivate current dots (the dot at position `current` within each slide group)
    for (let s = 0; s < total; s++) {
      const dot = dots[s * dotsPerSlide + current];
      if (dot) {
        dot.classList.remove('w-5', 'bg-brass');
        dot.classList.add('w-1.5', 'bg-ink-line', 'hover:bg-chalk-muted');
      }
    }

    current = index;

    // show new
    slides[current].style.opacity = '1';
    slides[current].style.pointerEvents = 'auto';
    // activate new dots
    for (let s = 0; s < total; s++) {
      const dot = dots[s * dotsPerSlide + current];
      if (dot) {
        dot.classList.remove('w-1.5', 'bg-ink-line', 'hover:bg-chalk-muted');
        dot.classList.add('w-5', 'bg-brass');
      }
    }
  }

  function startTimer() {
    timer = setInterval(() => goTo((current + 1) % total), 5000);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      clearInterval(timer);
      goTo(i % dotsPerSlide);
      startTimer();
    });
  });

  startTimer();
</script>
