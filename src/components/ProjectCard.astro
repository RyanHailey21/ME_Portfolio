---
import { Image } from 'astro:assets';

const baseUrl = import.meta.env.BASE_URL;

export interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  tags: string[];
  slug: string;
}

const { title, description, image, tags, slug } = Astro.props;
const finalHref = `${baseUrl}/projects/${slug}`;
---

<a href={finalHref} class="block group">
  <article class="bg-ink-card border border-ink-line rounded overflow-hidden transition-colors duration-200 group-hover:border-ink-subtle h-full flex flex-col">
    <!-- Image -->
    <div class="overflow-hidden aspect-[16/9]">
      <Image
        src={image}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    </div>

    <!-- Content -->
    <div class="p-6 flex flex-col flex-1">
      <h3 class="font-display text-xl font-medium text-chalk mb-2 leading-snug">{title}</h3>
      <p class="text-chalk-secondary text-sm leading-relaxed mb-4 line-clamp-2 flex-1">{description}</p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5 mt-auto">
        {tags.map((tag) => (
          <span class="px-2.5 py-1 text-[11px] font-mono text-chalk-muted border border-ink-line rounded tracking-wide">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Arrow indicator -->
    <div class="px-6 pb-5 flex items-center justify-between">
      <span class="font-mono text-xs text-chalk-muted tracking-wider uppercase group-hover:text-brass transition-colors duration-200">View Project</span>
      <svg class="w-4 h-4 text-chalk-muted group-hover:text-brass transition-all duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </article>
</a>
